{
  "arm_command_template": [
    "uv",
    "run",
    "python",
    "benchmarks/observe_hy3_dynamic_memory_arm.py",
    "--repo-root",
    ".",
    "--hooks",
    "mtplx.benchmarks.hy3_dynamic_memory_hardware:create_hooks",
    "--hooks-config",
    "benchmarks/specs/issue46-hy3-hardware-hooks.json",
    "--arm",
    "{arm}",
    "--context-tokens",
    "{context_tokens}",
    "--repetition",
    "{repetition}",
    "--hold-samples",
    "3",
    "--hold-interval-seconds",
    "0.5"
  ],
  "bootstrap_resamples": 10000,
  "bootstrap_seed": 46,
  "legacy_exclusive_lane_lock": "/tmp/mtplx-gpu-exclusive.lock",
  "workload_subprocess_timeout_seconds": 43200,
  "qwen_control_timeout_seconds": 300,
  "subprocess_termination_grace_seconds": 30,
  "artifact_verify_command": [
    "uv",
    "run",
    "python",
    "benchmarks/probe_hy3_component_slabs.py",
    "--hooks-config",
    "benchmarks/specs/issue46-hy3-hardware-hooks.json",
    "--verify-artifact-only"
  ],
  "probe_command": [
    "uv",
    "run",
    "python",
    "benchmarks/probe_hy3_component_slabs.py",
    "--hooks-config",
    "benchmarks/specs/issue46-hy3-hardware-hooks.json"
  ],
  "quality_command": [
    "uv",
    "run",
    "python",
    "benchmarks/benchmark_hy3_kv_quality.py",
    "--hooks-config",
    "benchmarks/specs/issue46-hy3-hardware-hooks.json"
  ],
  "qwen": {
    "acquire_lane_command": [
      "uv",
      "run",
      "python",
      "benchmarks/hy3_qwen_isolation.py",
      "acquire",
      "--expected-model",
      "mtplx-qwen36-27b-optimized-speed"
    ],
    "capture_command": [
      "uv",
      "run",
      "python",
      "benchmarks/hy3_qwen_isolation.py",
      "capture",
      "--expected-model",
      "mtplx-qwen36-27b-optimized-speed"
    ],
    "release_lane_command": [
      "uv",
      "run",
      "python",
      "benchmarks/hy3_qwen_isolation.py",
      "release",
      "--expected-model",
      "mtplx-qwen36-27b-optimized-speed"
    ],
    "restore_command": [
      "uv",
      "run",
      "python",
      "benchmarks/hy3_qwen_isolation.py",
      "restore",
      "--expected-model",
      "mtplx-qwen36-27b-optimized-speed"
    ],
    "unload_command": [
      "uv",
      "run",
      "python",
      "benchmarks/hy3_qwen_isolation.py",
      "unload",
      "--expected-model",
      "mtplx-qwen36-27b-optimized-speed"
    ],
    "verify_command": [
      "uv",
      "run",
      "python",
      "benchmarks/hy3_qwen_isolation.py",
      "verify",
      "--expected-model",
      "mtplx-qwen36-27b-optimized-speed"
    ]
  },
  "repetitions": 4
}
