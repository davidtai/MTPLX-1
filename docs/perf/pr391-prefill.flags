# PR-391 retained PREFILL stack -- the canonical record.
# Source of truth in code: mtplx/full_stack_env.py (group fable_prefill).
# tests/test_full_stack_profile.py asserts this file == that group.
# MTPLX_SESSION_BANK_MAX_BYTES is a serving MEMORY BUDGET, not a speed key:
# unset, the bank auto-sizes from the machine memory plan, and this set pins
# it so two arms cannot see different banks. Retune it per machine.
# NOTE: server_cell_bench.py's own COMMON_ENV exports
# MTPLX_SESSION_BANK_MAX_BYTES=auto, and an export beats the default -- so a
# battery run through that harness gets the auto-sizer, not 8G.
MTPLX_FABLE_PLE_PREFILL_LOOKAHEAD=1
MTPLX_FABLE_PLE_FIRST_GATHER_EARLY=1
MTPLX_PREFILL_CHUNK_SIZE=4096
MTPLX_QSA_PREFILL_COMPILE_ROWS=4096
MTPLX_FABLE_PREFILL_QSA_QUERY_TILE=2048
MTPLX_GDN_BLOCKED_PREFILL=1
MTPLX_FABLE_PREFILL_MASK_FUSE=1
MTPLX_SESSION_BANK_MAX_BYTES=8G
